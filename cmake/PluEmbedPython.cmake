# Compiles the engine's Python files (LibEngine/PluScripting/python/*.py) into a C++ source: one
# byte array per file and a null-terminated table of them, declared in
# LibEngine/PluScripting/src/EmbeddedPythonFiles.h. Run as a script:
#
#   cmake -DOUTPUT=<file.cpp> "-DINPUTS=<a.py>|<b.py>" -P PluEmbedPython.cmake
#
# INPUTS is '|'-separated because a ';' list does not survive add_custom_command as one argument.
# Byte arrays rather than raw string literals: MSVC caps a string literal at 64 KB, and an array has
# no delimiter that the embedded text could contain.

if (NOT OUTPUT OR NOT DEFINED INPUTS)
    message(FATAL_ERROR "PluEmbedPython.cmake: OUTPUT and INPUTS are required")
endif ()

string(REPLACE "|" ";" PLU_EMBED_INPUTS "${INPUTS}")

set(PLU_EMBED_ARRAYS "")
set(PLU_EMBED_TABLE "")
set(PLU_EMBED_INDEX 0)
foreach (PLU_EMBED_FILE IN LISTS PLU_EMBED_INPUTS)
    get_filename_component(PLU_EMBED_NAME "${PLU_EMBED_FILE}" NAME_WE)
    file(READ "${PLU_EMBED_FILE}" PLU_EMBED_HEX HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," PLU_EMBED_BYTES "${PLU_EMBED_HEX}")
    string(APPEND PLU_EMBED_ARRAYS "\t// ${PLU_EMBED_NAME}.py\n\tconst unsigned char kFile${PLU_EMBED_INDEX}[] = {${PLU_EMBED_BYTES}0x00};\n")
    string(APPEND PLU_EMBED_TABLE "\t\t{\"${PLU_EMBED_NAME}\", kFile${PLU_EMBED_INDEX}},\n")
    math(EXPR PLU_EMBED_INDEX "${PLU_EMBED_INDEX} + 1")
endforeach ()

set(PLU_EMBED_CONTENT "// AUTO-GENERATED by cmake/PluEmbedPython.cmake - DO NOT EDIT
// Sources: LibEngine/PluScripting/python/*.py

#include \"EmbeddedPythonFiles.h\"

namespace
{
${PLU_EMBED_ARRAYS}}

namespace Plu::Detail
{
\tconst EmbeddedPythonFile gEmbeddedPythonFiles[] = {
${PLU_EMBED_TABLE}\t\t{nullptr, nullptr},
\t};
}
")

# Rewritten only when it changed, so an unrelated reconfigure does not recompile it.
set(PLU_EMBED_OLD "")
if (EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" PLU_EMBED_OLD)
endif ()
if (NOT PLU_EMBED_OLD STREQUAL PLU_EMBED_CONTENT)
    file(WRITE "${OUTPUT}" "${PLU_EMBED_CONTENT}")
endif ()
