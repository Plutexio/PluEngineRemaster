{
  "version": 3,
  "configurePresets": [

    {
      "name": "base-linux",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
      }
    },
    {
      "name": "base-windows",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },

    {
      "name": "base-editor",
      "hidden": true,
      "cacheVariables": {
        "PLU_BUILD_EDITOR": "ON"
      }
    },
    {
      "name": "base-runtime",
      "hidden": true,
      "cacheVariables": {
        "PLU_BUILD_EDITOR": "OFF"
      }
    },

    {
      "name": "PluDebugLinux-Editor",
      "displayName": "Debug Linux [Editor]",
      "inherits": ["base-linux", "base-editor"],
      "binaryDir": "${sourceDir}/cmake-build-debug-editor",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "PluDebugLinux-Runtime",
      "displayName": "Debug Linux [Runtime]",
      "inherits": ["base-linux", "base-runtime"],
      "binaryDir": "${sourceDir}/cmake-build-debug-runtime",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },


    {
      "name": "PluDebugLinux-Tests",
      "displayName": "Debug Linux [Tests]",
      "inherits": ["base-linux"],
      "binaryDir": "${sourceDir}/cmake-build-debug-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PLU_TESTS_ONLY": "ON"
      }
    },
    {
      "name": "PluDebugLinux-Tests-TSan",
      "displayName": "Debug Linux [Tests + ThreadSanitizer]",
      "inherits": ["base-linux"],
      "binaryDir": "${sourceDir}/cmake-build-debug-tests-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PLU_TESTS_ONLY": "ON",
        "PLU_TESTS_TSAN": "ON"
      }
    },


    {
      "name": "PluDebugWindows-Editor",
      "displayName": "Debug Windows [Editor]",
      "inherits": ["base-windows", "base-editor"],
      "binaryDir": "${sourceDir}/cmake-build-debug-editor",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "PluDebugWindows-Runtime",
      "displayName": "Debug Windows [Runtime]",
      "inherits": ["base-windows", "base-runtime"],
      "binaryDir": "${sourceDir}/cmake-build-debug-runtime",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },


    {
      "name": "PluReleaseLinux-Editor",
      "displayName": "Release Linux [Editor]",
      "inherits": ["base-linux", "base-editor"],
      "binaryDir": "${sourceDir}/cmake-build-release-editor",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/DistL-Editor"
      }
    },
    {
      "name": "PluReleaseLinux-Runtime",
      "displayName": "Release Linux [Runtime]",
      "inherits": ["base-linux", "base-runtime"],
      "binaryDir": "${sourceDir}/cmake-build-release-runtime",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/DistL"
      }
    },


    {
      "name": "PluReleaseWindows-Editor",
      "displayName": "Release Windows [Editor]",
      "inherits": ["base-windows", "base-editor"],
      "binaryDir": "${sourceDir}/cmake-build-release-editor",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/DistW-Editor"
      }
    },
    {
      "name": "PluReleaseWindows-Runtime",
      "displayName": "Release Windows [Runtime]",
      "inherits": ["base-windows", "base-runtime"],
      "binaryDir": "${sourceDir}/cmake-build-release-runtime",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/DistW"
      }
    },


    {
      "name": "PluRelDbgLinux-Editor",
      "displayName": "RelWithDebInfo Linux [Editor]",
      "inherits": ["base-linux", "base-editor"],
      "binaryDir": "${sourceDir}/cmake-build-reldbg-editor",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "PluRelDbgLinux-Runtime",
      "displayName": "RelWithDebInfo Linux [Runtime]",
      "inherits": ["base-linux", "base-runtime"],
      "binaryDir": "${sourceDir}/cmake-build-reldbg-runtime",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },


    {
      "name": "PluRelDbgWindows-Editor",
      "displayName": "RelWithDebInfo Windows [Editor]",
      "inherits": ["base-windows", "base-editor"],
      "binaryDir": "${sourceDir}/cmake-build-reldbg-editor",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "PluRelDbgWindows-Runtime",
      "displayName": "RelWithDebInfo Windows [Runtime]",
      "inherits": ["base-windows", "base-runtime"],
      "binaryDir": "${sourceDir}/cmake-build-reldbg-runtime",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },


    {
      "name": "PluDistLinux-Editor",
      "displayName": "Distribution Linux [Editor]",
      "inherits": ["base-linux", "base-editor"],
      "binaryDir": "${sourceDir}/cmake-build-dist-editor",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PLU_DISTRIBUTION": "ON"
      }
    },
    {
      "name": "PluDistWindows-Editor",
      "displayName": "Distribution Windows [Editor]",
      "inherits": ["base-windows", "base-editor"],
      "binaryDir": "${sourceDir}/cmake-build-dist-editor",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PLU_DISTRIBUTION": "ON"
      }
    }
  ],

  "buildPresets": [
    { "name": "PluDebugLinux-Editor",      "configurePreset": "PluDebugLinux-Editor" },
    { "name": "PluDebugLinux-Runtime",     "configurePreset": "PluDebugLinux-Runtime" },
    { "name": "PluDebugLinux-Tests",       "configurePreset": "PluDebugLinux-Tests" },
    { "name": "PluDebugLinux-Tests-TSan",  "configurePreset": "PluDebugLinux-Tests-TSan" },
    { "name": "PluDebugWindows-Editor",    "configurePreset": "PluDebugWindows-Editor", "configuration": "Debug" },
    { "name": "PluDebugWindows-Runtime",   "configurePreset": "PluDebugWindows-Runtime", "configuration": "Debug" },
    { "name": "PluReleaseLinux-Editor",    "configurePreset": "PluReleaseLinux-Editor" },
    { "name": "PluReleaseLinux-Runtime",   "configurePreset": "PluReleaseLinux-Runtime" },
    { "name": "PluReleaseWindows-Editor",  "configurePreset": "PluReleaseWindows-Editor", "configuration": "Release" },
    { "name": "PluReleaseWindows-Runtime", "configurePreset": "PluReleaseWindows-Runtime", "configuration": "Release" },
    { "name": "PluRelDbgLinux-Editor",     "configurePreset": "PluRelDbgLinux-Editor" },
    { "name": "PluRelDbgLinux-Runtime",    "configurePreset": "PluRelDbgLinux-Runtime" },
    { "name": "PluRelDbgWindows-Editor",   "configurePreset": "PluRelDbgWindows-Editor", "configuration": "RelWithDebInfo" },
    { "name": "PluRelDbgWindows-Runtime",  "configurePreset": "PluRelDbgWindows-Runtime", "configuration": "RelWithDebInfo" },

    { "name": "PluDistLinux-Editor",       "configurePreset": "PluDistLinux-Editor",   "targets": ["DistributeEditor"] },
    { "name": "PluDistWindows-Editor",     "configurePreset": "PluDistWindows-Editor", "configuration": "Release", "targets": ["DistributeEditor"] }
  ]
}